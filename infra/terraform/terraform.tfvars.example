media_bucket_name    = "miscellary-media-prod-123456789012"
github_repository    = "your-github-name/miscellary"
github_owner_id      = "12345678"
github_repository_id = "123456789"
alert_email           = "you@example.com"

# Set this after adding the media ACM validation record, then apply and point
# media.miscellary.com at the media_cloudfront_domain output.
# media_cdn_enabled = true

# Set this only after the custom media hostname serves a render successfully.
# media_cdn_cutover = true

# Add this only after the image is in ECR and the ACM validation record is in DNS.
# api_image_tag = "0123456789abcdef0123456789abcdef01234567"

# Google sign-in uses the Web client ID, not the Android client ID or a client secret.
# google_web_client_id = "your-web-client-id.apps.googleusercontent.com"

# Add stripe_secret_key and stripe_webhook_secret to miscellary/app first.
# Keep purchases and live events disabled until the provider checks pass.
# stripe_configured = true
# stripe_price_ids = {
#   credits_125  = "price_..."
#   credits_275  = "price_..."
#   credits_600  = "price_..."
#   credits_1500 = "price_..."
#   subscription = "price_..."
# }
# stripe_portal_configuration = "bpc_..."
# monetization_enabled = false
# stripe_checkout_enabled = false
# stripe_live_approved = false

# Add server-only play_service_account JSON to miscellary/app first.
# play_configured = true
# play_rtdn_audience = "https://api.miscellary.com/api/v1/billing/play/notify/"
# play_rtdn_service_account = "your-push-identity@miscellary.iam.gserviceaccount.com"
# play_billing_enabled = false
# play_live_approved = false
