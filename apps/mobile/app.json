{
  "expo": {
    "name": "Miscellary",
    "slug": "miscellary",
    "scheme": "miscellary",
    "version": "0.0.1",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#f4eee1"
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#f9f4ea"
    },
    "newArchEnabled": true,
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.miscellary.app",
      "permissions": ["android.permission.CAMERA", "android.permission.READ_MEDIA_IMAGES"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#278b82"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Miscellary uses the camera to photograph the things you collect.",
          "microphonePermission": false,
          "photosPermission": "Miscellary uses your photo library to add photos of the things you collect."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f4eee1"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#278b82"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "469f68f7-224a-4dec-948d-d0432577c17a"
      }
    },
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "com.miscellary.app",
      "supportsTablet": true
    }
  }
}
