{
  "expo": {
    "name": "Miscellary",
    "slug": "miscellary",
    "scheme": "miscellary",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.miscellary.app",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Miscellary uses the camera to photograph the things you collect."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://10.0.2.2:8000"
    }
  }
}
