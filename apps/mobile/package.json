{
  "name": "mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "@types/react"
      ]
    }
  },
  "scripts": {
    "eas-build-post-install": "pnpm surfaces:build",
    "surfaces:build": "node scripts/build-surfaces.mjs",
    "renders:generate": "pnpm surfaces:build && node scripts/render-card-assets.mjs",
    "dev": "node scripts/build-surfaces.mjs --inline && expo start",
    "android": "node scripts/build-surfaces.mjs --inline && expo start --android",
    "build": "pnpm surfaces:build && expo export --platform android --output-dir dist",
    "typecheck": "pnpm surfaces:build && tsc --noEmit && tsc -p surfaces/tsconfig.json",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/connection.test.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "15.1.1",
    "@miscellary/shared": "workspace:*",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@miscellary/config": "workspace:*",
    "@types/node": "^22.15.30",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.28.0",
    "typescript": "~5.9.3"
  }
}
