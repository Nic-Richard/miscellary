SECRET_KEY=change-me
DATABASE_URL=postgres://miscellary:miscellary@localhost:5432/miscellary
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000
EMAIL_FROM=Miscellary <no-reply@localhost>
# Production: COOKIE_SECURE=true, and COOKIE_SAMESITE=None only if web and API are on
# unrelated domains (see docs/ADR-001-auth.md).
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Object storage. These defaults match the MinIO service in docker-compose.yml.
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION=us-east-1
AWS_STORAGE_BUCKET_NAME=miscellary-media
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MEDIA_PUBLIC_URL=http://localhost:9000/miscellary-media
